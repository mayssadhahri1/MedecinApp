<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Couleur de fond -->
    <solid android:color="#FFFFFF"/>

    <!-- Coins arrondis -->
    <corners android:radius="20dp"/>

    <!-- Ombre légère (simulée avec stroke gris clair) -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>

    <!-- Optionnel : ajout de padding interne -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>
</shape>
